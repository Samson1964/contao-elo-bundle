{
    "name": "schachbulle/contao-elo-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet FIDE-Elo-Listen und gibt Bestenlisten und Statistiken im Frontend aus. Noch nicht für den Praxiseinsatz geeignet, da die Elo-Liste der FIDE von Hand in die Datenbank importiert werden muss.",
    "keywords": [
        "contao",
        "schach",
        "elo",
        "fide",
        "bestenliste"
    ],
    "homepage": "https://github.com/Samson1964/contao-elo-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^5.6 || ^7.0 || ^8.0",
        "contao/core-bundle": "^4",
        "codefog/contao-haste": "*",
        "schachbulle/contao-helper-bundle": "*"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoEloBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoEloBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-elo-bundle/issues",
        "source": "https://github.com/Samson1964/contao-elo-bundle"
    }
}
