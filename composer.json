{
    "name": "schachbulle/contao-elo-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet FIDE-Elo-Listen mit deutschen Spielern und gibt Toplisten, Bestenlisten und Statistiken im Frontend aus. Die Ratingliste der FIDE wird als XML direkt im Backend importiert.",
    "keywords": [
        "contao",
        "schach",
        "elo",
        "fide",
        "bestenliste"
    ],
    "homepage": "https://github.com/Samson1964/contao-elo-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/cache": "^5.4 || ^6.0 || ^7.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoEloBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoEloBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-elo-bundle/issues",
        "source": "https://github.com/Samson1964/contao-elo-bundle"
    }
}
